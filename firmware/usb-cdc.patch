+
+#if USB_CDC
+// Incremented by Draw_Window each time it consumes FrameEndFlag; CAP? uses it to detect a finished frame
+extern vu8 UsbFrameCnt;
+// Parse/execute one pending serial command; call from the main loop right after Synchro()
+void UsbCmd_Poll(void);
+#endif
+
+#endif
