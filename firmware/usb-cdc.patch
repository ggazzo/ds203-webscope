+++ b/WildcatV6.5/build.sh
@@ -0,0 +1,5 @@
+#!/bin/sh
+# Builds with the Arm toolchain extracted next to the repo; GCC>=14 needs -std=gnu99.
+cd "$(dirname "$0")" || exit 1
+export PATH="$HOME/dev-hobby/ds203/toolchain/bin:$PATH"
+make CFLAGS="-Wall -O2 -I. -Iinc -std=gnu99 -mcpu=cortex-m3 -mthumb -fno-common -fzero-initialized-in-bss -msoft-float -MD -I FWLib/inc" "$@"
