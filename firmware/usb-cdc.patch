diff --git a/WildcatV6.5/inc/UsbCdc.h b/WildcatV6.5/inc/UsbCdc.h
new file mode 100644
index 0000000..be28e30
--- /dev/null
+++ b/WildcatV6.5/inc/UsbCdc.h
@@ -0,0 +1,20 @@
+#ifndef __USBCDC_H
+#define __USBCDC_H
+
+#include "stm32f10x_type.h"
+
+// 1 = app owns USB and enumerates as CDC-ACM; 0 = stock ROM mass-storage stack
+#define USB_CDC       1
+// 1 = ISR loops received bytes back to the host (prototype); 0 = bytes go to UsbCdc_Read
+#define USB_CDC_ECHO  0
+
+#if USB_CDC
+typedef struct { u16 isr, rst, susp, wkup, err, fix, istr, cntr, daddr; u8 cfg; } UsbDiag_t;
+const UsbDiag_t *UsbCdc_Diag(void);          // counters since boot (u16, wrap); cntr/daddr sampled now
+void UsbCdc_Init(void);
+void UsbCdc_Isr(void);
+int  UsbCdc_Read(u8 *buf, int len);          // returns bytes copied, 0 if none/not configured
+int  UsbCdc_Write(const u8 *buf, int len);   // returns bytes queued (tx ring is 256 B)
+#endif
+
+#endif
